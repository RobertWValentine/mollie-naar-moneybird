# Tokens. Op een Mac mag je ze ook in de keychain zetten in plaats van hier:
# service mollie-api en moneybird-api, account = KEYCHAIN_ACCOUNT.
MOLLIE_TOKEN=
MONEYBIRD_TOKEN=
KEYCHAIN_ACCOUNT=default

# Doeladministratie en rekening. De ID's vind je met --rekeningen.
MONEYBIRD_ADMINISTRATION_ID=
MONEYBIRD_FINANCIAL_ACCOUNT_ID=

# PayPal. Leeg laten als de administratie geen PayPal heeft; --paypal weigert
# dan met een melding. In de keychain: service paypal-api, accounts
# <KEYCHAIN_ACCOUNT>-client-id en <KEYCHAIN_ACCOUNT>-secret.
MONEYBIRD_PAYPAL_ACCOUNT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Hoe ver het script hoogstens terugkijkt als de state leeg is.
MAX_LOOKBACK_DAYS=14

# Pauze in seconden tussen de stappen bij het doorlopen van alle mutaties.
# Moneybird staat 150 verzoeken per 5 minuten toe.
MONEYBIRD_PAUZE=2.0

# Waar het script onthoudt wat al geboekt is. Standaard ~/.mollie-moneybird-sync/state.db.
# Op een server liever een vaste plek, bijvoorbeeld /var/lib/mollie-moneybird-sync/state.db.
# STATE_PATH=
# De lock staat standaard naast de state (mollie-moneybird-sync.lock). Zet hem nooit in
# een map waar andere gebruikers kunnen schrijven, zoals /tmp.
# LOCK_PATH=
# Na hoeveel minuten een bezette lock een fout is (exitcode 3) in plaats van een gewone overlap.
# LOCK_ALERT_MINUTES=60
